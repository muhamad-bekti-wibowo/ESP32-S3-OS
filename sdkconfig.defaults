# Target
CONFIG_IDF_TARGET="esp32s3"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Flash 16MB (dikonfirmasi via esptool flash_id di hardware nyata -
# sebelumnya salah dikonfigurasi 8MB, separuh flash tidak terpakai)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: app rollback otomatis kalau firmware baru gagal boot/gagal
# konfirmasi diri sendiri sehat (esp_ota_ops.h) - lihat main.c app_main().
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# SPIFFS untuk simpan webroot + program logika
CONFIG_SPIFFS_MAX_PARTITIONS=2

# HTTP server body size lebih besar untuk terima JSON program
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
